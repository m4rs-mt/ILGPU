# syntax=docker/dockerfile:1.7
#
# ILGPUC.CompilerService — CUDA image
#
# Base: ubuntu:24.04 + the CUDA 13.2 toolkit from NVIDIA's apt repository
#       (cuda-minimal-build-13-2: nvcc, ptxas, the CUDA headers and the host
#       compiler nvcc preprocesses through). nvcc + ptxas land at the default
#       path /usr/local/cuda/bin/, which is what
#       ILGPUC.Compilers/CompilerOptions.cs expects. Only the toolchain
#       packages the compiler service needs are installed, the same way the
#       OpenCL image installs Intel's packages from Intel's repository.
#
# Architectures: linux/amd64 (x86_64 repo), linux/arm64 (sbsa repo).
#
# Build context: REPO ROOT (the parent of Src/), so the build can pick up
#   - global.json
#   - Src/Directory.Build.props
#   - Tools/CheckStyles/ILGPU.CheckStyles.targets   (imported by props above)
#   - Src/ILGPU/Properties/ILGPU.nuspec.targets     (imported by ILGPU.csproj)
#
# Build:
#   docker build -f Src/docker/Dockerfile.cuda \
#       -t ilgpuc-compiler-service-cuda:13.2.0 .
#
# Run (requires NVIDIA Container Toolkit on the host):
#   docker run --rm -d --gpus all -p 5000:5000 \
#       --name ilgpuc-cuda \
#       ilgpuc-compiler-service-cuda:13.2.0
#

############################
# Stage 1: build
############################
FROM mcr.microsoft.com/dotnet/sdk:10.0-noble AS build
WORKDIR /src

# --- Restore-cache layer ---------------------------------------------------
# Copy only the files needed by `dotnet restore` so this layer is reused on
# every source-only change.

COPY global.json ./
COPY Src/Directory.Build.props                                Src/
COPY Tools/CheckStyles/ILGPU.CheckStyles.targets              Tools/CheckStyles/

# Project files + their imports (ILGPU.nuspec.targets is imported by ILGPU.csproj)
COPY Src/ILGPU/ILGPU.csproj                                   Src/ILGPU/
COPY Src/ILGPU/Properties/ILGPU.nuspec.targets                Src/ILGPU/Properties/
COPY Src/ILGPUC.Compilers/ILGPUC.Compilers.csproj             Src/ILGPUC.Compilers/
COPY Src/ILGPUC.CompilerService/ILGPUC.CompilerService.csproj Src/ILGPUC.CompilerService/

RUN dotnet restore Src/ILGPUC.CompilerService/ILGPUC.CompilerService.csproj

# --- Source + publish ------------------------------------------------------
# ILGPU's T4 templates pull `.ttinclude` files from Src/ILGPUC/Static/ via
# `<#@ include file="../../ILGPUC/Static/..." #>`, so the static directory
# from the (otherwise unrelated) ILGPUC project must be present at codegen
# time. We do NOT need to build ILGPUC itself.
COPY Src/ILGPU/                  Src/ILGPU/
COPY Src/ILGPUC/Static/          Src/ILGPUC/Static/
COPY Src/ILGPUC.Compilers/       Src/ILGPUC.Compilers/
COPY Src/ILGPUC.CompilerService/ Src/ILGPUC.CompilerService/

RUN dotnet publish Src/ILGPUC.CompilerService/ILGPUC.CompilerService.csproj \
        -c Release \
        -o /app/publish \
        --no-restore \
        /p:UseAppHost=false

############################
# Stage 2: runtime (Ubuntu + CUDA toolkit)
############################
FROM ubuntu:24.04 AS runtime

# Set by BuildKit for the platform being built (amd64 / arm64). The legacy
# `docker build` builder leaves it empty, so the install step below falls
# back to the container's own architecture.
ARG TARGETARCH

# Keep apt non-interactive for the toolkit install below (tzdata et al.);
# the ENV of the same name further down only covers later layers.
ARG DEBIAN_FRONTEND=noninteractive

# OCI labels — auto-link the GHCR package back to the source repo (so it
# appears under the repo's Packages tab) and tag it with the compound license
# set that actually applies: ILGPU code is NCSA; the CUDA toolkit is governed
# by the CUDA Toolkit EULA (referenced via SPDX LicenseRef-* for
# non-SPDX-identifier licenses).
LABEL org.opencontainers.image.source="https://github.com/m4rs-mt/ILGPU"
LABEL org.opencontainers.image.licenses="NCSA AND LicenseRef-NVIDIA-CUDA-Toolkit-EULA"
LABEL org.opencontainers.image.description="ILGPUC CompilerService bundled with the CUDA toolchain (nvcc + ptxas). Used as a remote compile-only service AND as a CI test runner: `docker run image dotnet test ...` overrides the default CMD to run tests inside the container with the .NET 10 SDK preinstalled."

# Install the CUDA 13.2 compiler toolchain from NVIDIA's apt repository.
# cuda-minimal-build-13-2 pulls in nvcc, ptxas, the CUDA runtime headers,
# CCCL and build-essential (nvcc preprocesses through the host compiler,
# even for -ptx / -cubin output). The keyring package registers the signed
# repository for the target architecture.
RUN arch="${TARGETARCH:-$(dpkg --print-architecture)}" \
 && case "${arch}" in \
        amd64) cuda_repo=x86_64 ;; \
        arm64) cuda_repo=sbsa ;; \
        *) echo "unsupported architecture: ${arch}" >&2; exit 1 ;; \
    esac \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && curl -fsSL "https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/${cuda_repo}/cuda-keyring_1.1-1_all.deb" \
        -o /tmp/cuda-keyring.deb \
 && dpkg -i /tmp/cuda-keyring.deb \
 && rm /tmp/cuda-keyring.deb \
 && apt-get update \
 && apt-get install -y --no-install-recommends cuda-minimal-build-13-2 \
 && ln -sfn /usr/local/cuda-13.2 /usr/local/cuda \
 && rm -rf /var/lib/apt/lists/*

# Bundle ILGPU's own license texts. Third-party licenses are already present
# in the image: every apt-packaged component's copyright/license text sits at
# /usr/share/doc/<package>/copyright per Debian convention.
COPY LICENSE.txt LICENSE-3RD-PARTY.txt /usr/share/doc/ilgpuc/

# An index pointing at every license text present in the image filesystem,
# so a consumer inspecting the image has a single starting point.
RUN printf '%s\n' \
    'The CUDA toolkit components in this image (nvcc, ptxas, headers and' \
    'libraries) were installed from NVIDIA'"'"'s apt repository and are governed' \
    'by the NVIDIA CUDA Toolkit End User License Agreement:' \
    '  https://docs.nvidia.com/cuda/eula/index.html' \
    '' \
    'ILGPU source code is licensed under the University of Illinois/NCSA' \
    'Open Source License. The full text is present in the image at:' \
    '  /usr/share/doc/ilgpuc/LICENSE.txt' \
    'Attributions for bundled third-party ILGPU dependencies are at:' \
    '  /usr/share/doc/ilgpuc/LICENSE-3RD-PARTY.txt' \
    '' \
    'Licenses for other apt-installed components (CUDA toolkit packages,' \
    'Ubuntu base packages, .NET runtime dependencies, etc.) are at their' \
    'Debian-convention paths:' \
    '  /usr/share/doc/<package>/copyright' \
    > /usr/share/doc/ilgpuc/NOTICES

ENV DEBIAN_FRONTEND=noninteractive \
    DOTNET_ROOT=/usr/share/dotnet \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_NOLOGO=true \
    DOTNET_PRINT_TELEMETRY_MESSAGE=false \
    ASPNETCORE_URLS=http://+:5000 \
    ASPNETCORE_ENVIRONMENT=Production \
    PATH=/usr/share/dotnet:/usr/local/cuda/bin:$PATH

# Install the full .NET 10 SDK via dotnet-install.sh. The SDK is a superset
# of the ASP.NET Core runtime (the CompilerService still starts via the same
# `dotnet ILGPUC.CompilerService.dll` invocation), but additionally lets
# `dotnet test` run inside the container — which is how the GitHub Actions
# CI test workflow uses these images: pull the image, bind-mount the
# prebuilt test binaries, exec `dotnet test --no-build --filter ...`.
# Adds ~700 MB to the image vs --runtime aspnetcore but unlocks CI use.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates curl libicu74 libssl3 libstdc++6 zlib1g tzdata \
 && curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
 && chmod +x /tmp/dotnet-install.sh \
 && /tmp/dotnet-install.sh --channel 10.0 \
        --install-dir /usr/share/dotnet \
 && rm /tmp/dotnet-install.sh \
 && rm -rf /var/lib/apt/lists/*

# Non-root user.
# Ubuntu 24.04 ships with a default `ubuntu` user at uid/gid 1000, so we
# remove it before claiming uid 1000 ourselves. The `|| true` keeps this
# step idempotent on bases that don't have it (and across rebuilds).
RUN (userdel -r ubuntu 2>/dev/null || true) \
 && (groupdel ubuntu 2>/dev/null || true) \
 && groupadd --system --gid 1000 ilgpuc \
 && useradd  --system --uid 1000 --gid 1000 \
             --home /home/ilgpuc --shell /usr/sbin/nologin ilgpuc \
 && mkdir -p /home/ilgpuc /app \
 && chown -R ilgpuc:ilgpuc /home/ilgpuc /app

WORKDIR /app
COPY --from=build --chown=ilgpuc:ilgpuc /app/publish ./

USER ilgpuc

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS http://localhost:5000/api/v1/status || exit 1

# CMD (not ENTRYPOINT) so `docker run image dotnet test ...` cleanly
# overrides the default. The default behavior is unchanged: `docker run
# image` (with no args) starts the CompilerService exactly like before.
CMD ["dotnet", "ILGPUC.CompilerService.dll"]
