# syntax=docker/dockerfile:1.7
#
# ILGPUC.CompilerService — ROCm image
#
# Base: ubuntu:24.04 + the ROCm 7.1.1 HIP toolchain from AMD's apt repository
#       (rocm-hip-runtime-dev: hipcc, amdclang++, the HIP headers and the
#       device libraries) at /opt/rocm/bin/, matching what
#       ILGPUC.Compilers/CompilerOptions.cs expects. Same pattern as the CUDA
#       and OpenCL images: a plain Ubuntu base plus only the vendor packages
#       the compiler needs, installed from the vendor's own repository.
#
# Architectures: linux/amd64 only. AMD publishes no arm64 ROCm packages.
#
# NOTE: As of ROCm 7.2.0, hipcc is deprecated in favour of amdclang++ — it
# still works but is now a thin wrapper. The 7.1.1 pin keeps hipcc
# fully functional. Migrate ILGPUC.Compilers later if needed.
#
# Build context: REPO ROOT (the parent of Src/), so the build can pick up
#   - global.json
#   - Src/Directory.Build.props
#   - Tools/CheckStyles/ILGPU.CheckStyles.targets   (imported by props above)
#   - Src/ILGPU/Properties/ILGPU.nuspec.targets     (imported by ILGPU.csproj)
#
# Build:
#   docker build -f Src/docker/Dockerfile.rocm \
#       -t ilgpuc-compiler-service-rocm:7.1.1 .
#
# Run (needs /dev/kfd + /dev/dri exposed and the video group):
#   docker run --rm -d \
#       --device=/dev/kfd --device=/dev/dri --group-add video \
#       -p 5000:5000 \
#       --name ilgpuc-rocm \
#       ilgpuc-compiler-service-rocm:7.1.1
#

############################
# Stage 1: build
############################
FROM mcr.microsoft.com/dotnet/sdk:10.0-noble AS build
WORKDIR /src

# --- Restore-cache layer ---------------------------------------------------
COPY global.json ./
COPY Src/Directory.Build.props                                Src/
COPY Tools/CheckStyles/ILGPU.CheckStyles.targets              Tools/CheckStyles/

COPY Src/ILGPU/ILGPU.csproj                                   Src/ILGPU/
COPY Src/ILGPU/Properties/ILGPU.nuspec.targets                Src/ILGPU/Properties/
COPY Src/ILGPUC.Compilers/ILGPUC.Compilers.csproj             Src/ILGPUC.Compilers/
COPY Src/ILGPUC.CompilerService/ILGPUC.CompilerService.csproj Src/ILGPUC.CompilerService/

RUN dotnet restore Src/ILGPUC.CompilerService/ILGPUC.CompilerService.csproj

# --- Source + publish ------------------------------------------------------
# ILGPU's T4 templates pull `.ttinclude` files from Src/ILGPUC/Static/ via
# `<#@ include file="../../ILGPUC/Static/..." #>`, so the static directory
# from the (otherwise unrelated) ILGPUC project must be present at codegen
# time. We do NOT need to build ILGPUC itself.
COPY Src/ILGPU/                  Src/ILGPU/
COPY Src/ILGPUC/Static/          Src/ILGPUC/Static/
COPY Src/ILGPUC.Compilers/       Src/ILGPUC.Compilers/
COPY Src/ILGPUC.CompilerService/ Src/ILGPUC.CompilerService/

RUN dotnet publish Src/ILGPUC.CompilerService/ILGPUC.CompilerService.csproj \
        -c Release \
        -o /app/publish \
        --no-restore \
        /p:UseAppHost=false

############################
# Stage 2: runtime (Ubuntu + ROCm HIP toolchain)
############################
FROM ubuntu:24.04 AS runtime

# Keep apt non-interactive for the toolchain install below (tzdata et al.);
# the ENV of the same name further down only covers later layers.
ARG DEBIAN_FRONTEND=noninteractive

# OCI labels — auto-link the GHCR package back to the source repo (so it
# appears under the repo's Packages tab) and tag it with the compound license
# set that actually applies: ILGPU code is NCSA; ROCm is a per-component
# multi-license SDK — hipcc is MIT, amdclang++ derives from LLVM (Apache-2.0
# with LLVM exception), Comgr is NCSA, runtime libs are MIT/Apache-2.0 mixed.
# AMD documents this at
#   https://rocm.docs.amd.com/en/latest/about/license.html
LABEL org.opencontainers.image.source="https://github.com/m4rs-mt/ILGPU"
LABEL org.opencontainers.image.licenses="NCSA AND MIT AND Apache-2.0"
LABEL org.opencontainers.image.description="ILGPUC CompilerService bundled with the ROCm 7.1.1 toolchain (hipcc + amdclang++). Used as a remote compile-only service AND as a CI test runner: `docker run image dotnet test ...` overrides the default CMD to run tests inside the container with the .NET 10 SDK preinstalled."

# Install the ROCm 7.1.1 HIP toolchain from AMD's apt repository.
# rocm-hip-runtime-dev pulls in hipcc, rocm-llvm (amdclang++), the HIP
# headers, the device libraries and the HIP runtime; hipcc -c compiles host
# and device code, so the libstdc++ development headers come along as
# rocm-llvm dependencies. ROCm's lld links against libxml2 without declaring
# it, so it is installed explicitly. The repository is pinned above Ubuntu's
# own packages, as AMD's installation guide recommends.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
 && mkdir -p /etc/apt/keyrings \
 && curl -fsSL https://repo.radeon.com/rocm/rocm.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/rocm.gpg \
 && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/rocm.gpg] https://repo.radeon.com/rocm/apt/7.1.1 noble main" \
        > /etc/apt/sources.list.d/rocm.list \
 && printf 'Package: *\nPin: release o=repo.radeon.com\nPin-Priority: 600\n' \
        > /etc/apt/preferences.d/rocm-pin-600 \
 && apt-get update \
 && apt-get install -y --no-install-recommends rocm-hip-runtime-dev libxml2 \
 && { [ -e /opt/rocm ] || ln -s /opt/rocm-7.1.1 /opt/rocm; } \
 && rm -rf /var/lib/apt/lists/*

# Bundle ILGPU's own license texts. Third-party licenses are already present
# in the image: every apt-packaged ROCm and system component's copyright /
# license text sits at /usr/share/doc/<package>/copyright per Debian
# convention — no further bundling needed for those.
COPY LICENSE.txt LICENSE-3RD-PARTY.txt /usr/share/doc/ilgpuc/

# Index pointing at every license text already present in the image
# filesystem, so a consumer inspecting the image has a single starting point.
RUN printf '%s\n' \
    'The ROCm components in this image were installed from AMD'"'"'s apt' \
    'repository (rocm-hip-runtime-dev, ROCm 7.1.1). ROCm is a multi-license' \
    'SDK — core components are MIT, LLVM-derived components (amdclang++) are' \
    'Apache-2.0 with LLVM exception, Comgr is NCSA. Per-component details:' \
    '  https://rocm.docs.amd.com/en/latest/about/license.html' \
    'Per-package license texts are in the image at:' \
    '  /usr/share/doc/<package>/copyright' \
    '' \
    'ILGPU source code is licensed under the University of Illinois/NCSA' \
    'Open Source License. The full text is present in the image at:' \
    '  /usr/share/doc/ilgpuc/LICENSE.txt' \
    'Attributions for bundled third-party ILGPU dependencies are at:' \
    '  /usr/share/doc/ilgpuc/LICENSE-3RD-PARTY.txt' \
    > /usr/share/doc/ilgpuc/NOTICES

ENV DEBIAN_FRONTEND=noninteractive \
    DOTNET_ROOT=/usr/share/dotnet \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_NOLOGO=true \
    DOTNET_PRINT_TELEMETRY_MESSAGE=false \
    ASPNETCORE_URLS=http://+:5000 \
    ASPNETCORE_ENVIRONMENT=Production \
    PATH=/usr/share/dotnet:/opt/rocm/bin:$PATH

# Install the full .NET 10 SDK via dotnet-install.sh. The SDK is a superset
# of the ASP.NET Core runtime (the CompilerService still starts via the same
# `dotnet ILGPUC.CompilerService.dll` invocation), but additionally lets
# `dotnet test` run inside the container — which is how the GitHub Actions
# CI test workflow uses these images. See Dockerfile.cuda for the rationale.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates curl libicu74 libssl3 libstdc++6 zlib1g tzdata \
 && curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
 && chmod +x /tmp/dotnet-install.sh \
 && /tmp/dotnet-install.sh --channel 10.0 \
        --install-dir /usr/share/dotnet \
 && rm /tmp/dotnet-install.sh \
 && rm -rf /var/lib/apt/lists/*

# Non-root user. ROCm device access typically also requires the host's
# `video` (and on newer kernels `render`) groups; pass --group-add at run time.
#
# Ubuntu 24.04 ships with a default `ubuntu` user at uid/gid 1000, so we
# remove it before claiming uid 1000 ourselves. The `|| true` keeps this
# step idempotent on bases that don't have it (and across rebuilds).
RUN (userdel -r ubuntu 2>/dev/null || true) \
 && (groupdel ubuntu 2>/dev/null || true) \
 && groupadd --system --gid 1000 ilgpuc \
 && useradd  --system --uid 1000 --gid 1000 \
             --home /home/ilgpuc --shell /usr/sbin/nologin ilgpuc \
 && mkdir -p /home/ilgpuc /app \
 && chown -R ilgpuc:ilgpuc /home/ilgpuc /app

WORKDIR /app
COPY --from=build --chown=ilgpuc:ilgpuc /app/publish ./

USER ilgpuc

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS http://localhost:5000/api/v1/status || exit 1

# CMD (not ENTRYPOINT) so `docker run image dotnet test ...` cleanly
# overrides the default. The default behavior is unchanged: `docker run
# image` (with no args) starts the CompilerService exactly like before.
CMD ["dotnet", "ILGPUC.CompilerService.dll"]
