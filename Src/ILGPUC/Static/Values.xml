    <Group Name="Threads" Namespace="BasicBlockValues">
        <Value Type="Barrier" Implementation="Barrier">
            <Property Name="Kind">
                <PropertyValue Name="WarpLevel"
                    Description="A barrier that operates on warp level." />
                <PropertyValue Name="GroupLevel"
                    Description="A barrier that operates on group level." />
            </Property>
        </Value>
        <Value Type="Broadcast" Implementation="Broadcast">
            <Property Name="Kind">
                <PropertyValue Name="WarpLevel"
                    Description="A broadcast operation that operates on warp level." />
                <PropertyValue Name="GroupLevel"
                    Description="A broadcast operation that operates on group level." />
            </Property>
        </Value>
        <Value Type="PredicateBarrier" Implementation="PredicateBarrier">
            <Property Name="Kind">
                <PropertyValue Name="WarpLevel"
                    Description="A predicate barrier that operates on warp level." />
                <PropertyValue Name="GroupLevel"
                    Description="A predicate barrier that operates on group level." />
            </Property>
            <Property Name="PredicateKind">
                <PropertyValue Name="PopCount"
                    Description="Returns the number of threads in the group for which the predicate evaluates to true." />
                <PropertyValue Name="And"
                    Description="Returns the logical and result of the predicate of all threads in the group." />
                <PropertyValue Name="Or"
                    Description="Returns the logical or result of the predicate of all threads in the group." />
            </Property>
        </Value>
        <Value Type="Shuffle" Implementation="Shuffle">
            <Property Name="Kind">
                <PropertyValue Name="Generic"
                    Description="A generic shuffle operation." />
                <PropertyValue Name="Down"
                    Description="A down-shuffle operation." />
                <PropertyValue Name="Up"
                    Description="An up-shuffle operation." />
                <PropertyValue Name="Xor"
                    Description="An xor-shuffle operation." />
            </Property>
        </Value>
        <Value Type="WarpReduce" Implementation="WarpReduce">
            <Property Name="Kind">
                <PropertyValue Name="Reduce"
                    Description="Warp-wide reduction with first-lane-only result." />
                <PropertyValue Name="AllReduce"
                    Description="Warp-wide reduction with all-lanes result via butterfly." />
            </Property>
        </Value>
        <Value Type="WarpScan" Implementation="WarpScan">
            <Property Name="Kind">
                <PropertyValue Name="Inclusive"
                    Description="Inclusive prefix scan." />
                <PropertyValue Name="Exclusive"
                    Description="Exclusive prefix scan (requires identity element)." />
            </Property>
        </Value>
        <Value Type="GroupReduce" Implementation="GroupReduce">
            <Property Name="Kind">
                <PropertyValue Name="Reduce"
                    Description="Group-wide reduction with first-thread-only result." />
                <PropertyValue Name="AllReduce"
                    Description="Group-wide reduction with all-threads result." />
            </Property>
        </Value>
        <Value Type="GroupScan" Implementation="GroupScan">
            <Property Name="Kind">
                <PropertyValue Name="Inclusive"
                    Description="Group-wide inclusive prefix scan." />
                <PropertyValue Name="Exclusive"
                    Description="Group-wide exclusive prefix scan." />
            </Property>
        </Value>
        <Value Type="WarpRadixSort" Implementation="WarpRadixSort"
            Description="Warp-wide radix sort." />
        <Value Type="GroupRadixSort" Implementation="GroupRadixSort"
            Description="Group-wide radix sort." />
