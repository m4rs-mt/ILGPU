<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <VersionPrefix>$(LibraryVersionPrefix)</VersionPrefix>
    <AssemblyVersion>$(LibraryAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(LibraryFileVersion)</FileVersion>
  </PropertyGroup>

  <!-- Enable Nullable Reference Types, but only check for warnings on the latest framework -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' != '$(LibraryLatestTargetFramework)'">
    <NoWarn>$(NoWarn);nullable</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NeutralLanguage>en-US</NeutralLanguage>
    <LangVersion>13.0</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>../../Bin/$(Configuration)/</OutputPath>
    <DocumentationFile>../../Bin/$(Configuration)/$(TargetFramework)/ILGPUC.xml</DocumentationFile>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Turn off package validation for now to avoid checks against non-supported frameworks -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <PackageValidationBaselineVersion>$(LibraryPackageValidationBaselineVersion)</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ILGPUC.Tests" />
    <InternalsVisibleTo Include="ILGPUC.CompilerService.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ILGPU\ILGPU.csproj" />
    <ProjectReference Include="..\ILGPUC.Compilers\ILGPUC.Compilers.csproj" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta5.25306.1" />
    <PackageReference Include="T4.Build" Version="0.2.5" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.12.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build/**" Pack="true" PackagePath="build/" />
  </ItemGroup>

  <!-- Packaging: ILGPUC ships as an MSBuild-task package (build/ILGPUC.targets
       auto-imports ILGPU.Kernels.targets, which invokes the ilgpuc tool from
       tools/<tfm>/). The actual tool binaries are staged into tools/ by
       Src/scripts/pack-ilgpuc.sh and globbed in via $(ILGPUCPackStagingDir)
       below. lib/<tfm>/ stays empty: the package is not consumed as an
       assembly reference. -->
  <PropertyGroup>
    <!-- IsPackable gates on the staging dir so plain `dotnet pack Src` skips
         ILGPUC entirely (a metadata-only nupkg without tools/ is broken).
         Src/scripts/pack-ilgpuc.sh sets ILGPUCPackStagingDir which flips
         this on. The NuGetIntegrationTests test does the same. -->
    <IsPackable Condition="'$(ILGPUCPackStagingDir)' != ''">true</IsPackable>
    <IsPackable Condition="'$(ILGPUCPackStagingDir)' == ''">false</IsPackable>
    <PackageId>ILGPUC</PackageId>
    <Title>ILGPUC</Title>
    <Authors>Marcel Koester</Authors>
    <Copyright>Copyright (c) 2016-2026 ILGPU Project. All rights reserved.</Copyright>
    <Description>ILGPU AOT compiler toolchain. Compiles GPU kernels at build time via the ILGPU.Kernels.targets MSBuild integration.</Description>
    <PackageDescription>
      ILGPU AOT compiler. Add a &lt;PackageReference&gt; and the bundled MSBuild
      targets file rewrites stream.Launch() call sites and emits CompiledKernel
      classes for the configured backend(s) before csc runs. Ships R2R-accelerated
      native binaries for osx-arm64, linux-x64, and win-x64 with a JIT fallback
      for other RIDs.
    </PackageDescription>
    <PackageProjectUrl>http://www.ilgpu.net</PackageProjectUrl>
    <PackageReleaseNotes>http://www.ilgpu.net/releases</PackageReleaseNotes>
    <PackageTags>ilgpu gpu cuda metal opencl rocm aot compiler msbuild</PackageTags>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <!-- Suppress the default lib/<tfm>/ILGPUC.dll payload — the package is
         not consumed as an assembly reference; the tool lives in tools/. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- We bundle Roslyn DLLs inside tools/. Don't also force consumers to
         pull them as transitive package deps. -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Source Link / symbols: keep parity with ILGPU.nuspec.targets. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.txt" Link="LICENSE.txt" Pack="true"
          PackagePath="$(PackageLicenseFile)" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="$(PackageReadmeFile)" />
  </ItemGroup>

  <!-- $(ILGPUCPackStagingDir) is set by pack-ilgpuc.sh to a directory
       containing the tools/<tfm>/[<rid>/] tree produced by per-RID
       `dotnet publish`. This glob feeds those staged binaries into the
       resulting nupkg under tools/. Without the staging dir set, pack
       produces a metadata-only package (intentionally — bare `dotnet pack`
       won't ship a usable tool, see the script). -->
  <ItemGroup Condition="'$(ILGPUCPackStagingDir)' != ''">
    <None Include="$(ILGPUCPackStagingDir)\tools\**\*"
          Pack="true"
          PackagePath="tools\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\ErrorMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ErrorMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\RuntimeErrorMessages.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>RuntimeErrorMessages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>