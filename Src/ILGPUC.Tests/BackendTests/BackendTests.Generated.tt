// disable: max_line_length
<#@ template debug="false" hostspecific="false" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ output extension=".cs" #>
<#
// Class name prefix, backend type and native compiler (null if the backend has
// no native compilation)
var backends = new[]
{
    new[] { "Cpu", "CPU", null },
    new[] { "Metal", "Metal", "xcrun metal" },
    new[] { "Cuda", "Cuda", "nvcc" },
    new[] { "ROCm", "ROCm", "hipcc" },
    new[] { "OpenCL", "OpenCL", "ocloc" },
};

// xUnit runs the tests of a class one after another and different classes in
// parallel, so the kernels are split over several native compilation classes.
const int NativeShards = 4;
#>
