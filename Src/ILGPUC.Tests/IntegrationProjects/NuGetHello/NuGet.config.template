<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The local test feed ships ONLY ILGPUC itself. Its transitive
       dependencies (ILGPU, ILGPUC.Compilers, System.CommandLine,
       Microsoft.CodeAnalysis.CSharp, ...) come from nuget.org. The point of
       the test is to verify that NuGet auto-imports build/ILGPUC.targets
       from the package, not that the package is fully self-contained. -->
  <packageSources>
    <clear />
    <add key="ilgpuc-test-feed" value="$(ILGPUC_TEMP_FEED)" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
