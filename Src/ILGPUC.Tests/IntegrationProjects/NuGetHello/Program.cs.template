// NuGetHello: same shape as HelloKernel but consumed via PackageReference
// to verify that the .targets file is auto-imported from the NuGet package.
// Expected output: 0 3 6 9

using System;
using ILGPU;
using ILGPU.Runtime;

namespace NuGetHello;

static class Kernels
{
    public static void TripleKernel(
        Index1D index, ArrayView1D<int, Stride1D.Dense> data)
    {
        data[index] = index.X * 3;
    }
}

static class Program
{
    static void Main()
    {
        using var context = Context.Create(b => b.Default());
        using var accelerator = context.GetPreferredDevice(preferCPU: $(PREFER_CPU))
            .CreateAccelerator(context);
        var stream = accelerator.DefaultStream;

        using var buffer = stream.Allocate1D<int>(4);
        stream.Launch(
            (Index1D)4,
            index => Kernels.TripleKernel(index, buffer.View));
        stream.Synchronize();

        foreach (var v in buffer.GetAsArray1D())
            Console.WriteLine(v);
    }
}
