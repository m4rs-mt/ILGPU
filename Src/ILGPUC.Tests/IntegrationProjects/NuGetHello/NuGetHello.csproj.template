<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NuGetHello</RootNamespace>
    <AssemblyName>NuGetHello</AssemblyName>

    <!-- Per-test isolated NuGet packages folder so this test can't pollute
         and isn't polluted by the user's global cache. -->
    <RestorePackagesPath>$(MSBuildThisFileDirectory)packages/</RestorePackagesPath>
    <RestoreNoCache>true</RestoreNoCache>

    <!-- The .targets file is auto-imported from the package's build/ dir,
         which auto-resolves $(ILGPUCompilerTool) against the package's
         tools/ layout (per-RID R2R exe or JIT fallback). No override
         needed — that path *is* the test's point. -->
    <ILGPUBackend>$(ILGPU_BACKEND)</ILGPUBackend>
  </PropertyGroup>

  <ItemGroup>
    <!-- A single PackageReference must give the consumer:
         (a) the ILGPUC build-time tooling (build/ + tools/ in this nupkg),
         (b) a runtime reference to ILGPU.dll for ArrayView<T>, Index1D, etc.
         (b) flows in via NuGet's transitive dependency resolution because
         ILGPUC's published .nuspec lists ILGPU as a public dependency. The
         test asserts both — if the transitive flow is broken, the consumer's
         compile fails with CS0246 (type ArrayView not found). -->
    <PackageReference Include="ILGPUC" Version="$(ILGPUC_PACKAGE_VERSION)" />
  </ItemGroup>

</Project>
