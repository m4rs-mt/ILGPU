<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>NuGetHello</RootNamespace>
    <AssemblyName>NuGetHello</AssemblyName>

    <!-- Per-test isolated NuGet packages folder so this test can't pollute
         and isn't polluted by the user's global cache. -->
    <RestorePackagesPath>$(MSBuildThisFileDirectory)packages/</RestorePackagesPath>
    <RestoreNoCache>true</RestoreNoCache>

    <!-- The .targets file is auto-imported from the package's build/ dir,
         which auto-resolves $(ILGPUCompilerTool) against the package's
         tools/ layout (per-RID R2R exe or JIT fallback). No override
         needed — that path *is* the test's point. -->
    <ILGPUBackend>$(ILGPU_BACKEND)</ILGPUBackend>
  </PropertyGroup>

  <ItemGroup>
    <!-- The point of this test: the ILGPUC NuGet package's
         build/ILGPU.Kernels.targets must be auto-imported. -->
    <PackageReference Include="ILGPUC" Version="$(ILGPUC_PACKAGE_VERSION)" />

    <Reference Include="ILGPU">
      <HintPath>$(ILGPU_REPO_ROOT)/Bin/Debug/net10.0/ILGPU.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
