<Project>
  <!-- Library Project Configuration -->
  <PropertyGroup>
    <LibraryTargetFrameworks>net8.0</LibraryTargetFrameworks>
    <LibraryLatestTargetFramework>$(LibraryTargetFrameworks)</LibraryLatestTargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <LibraryTargetFrameworks>$(LibraryTargetFrameworks);net471;netstandard2.1</LibraryTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <LibraryVersionPrefix>1.6.0-beta1</LibraryVersionPrefix>
    <LibraryAssemblyVersion>1.6.0.0</LibraryAssemblyVersion>
    <LibraryFileVersion>1.6.0.0</LibraryFileVersion>
    <LibraryPackageValidationBaselineVersion>1.5.3</LibraryPackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- Unit Test Project Configuration -->
  <PropertyGroup>
    <LibraryUnitTestTargetFrameworks>net8.0</LibraryUnitTestTargetFrameworks>
    <LibraryLatestUnitTestTargetFramework>$(LibraryUnitTestTargetFrameworks)</LibraryLatestUnitTestTargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <LibraryUnitTestTargetFrameworks>$(LibraryUnitTestTargetFrameworks);net471</LibraryUnitTestTargetFrameworks>
  </PropertyGroup>

  <Import Project="..\Tools\CheckStyles\ILGPU.CheckStyles.targets" />
</Project>
