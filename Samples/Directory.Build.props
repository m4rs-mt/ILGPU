<Project>

  <PropertyGroup>
    <SamplesTargetFramework>net10.0</SamplesTargetFramework>
    <LangVersion>13.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>

    <!-- Path to pre-built ILGPU + ILGPUC artifacts.
         Build Src/ILGPU.sln first: dotnet build Src/ILGPU.sln -->
    <ILGPUBinDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../Bin/$(Configuration)/net10.0'))</ILGPUBinDir>

    <!-- Backend(s) to compile for. Semicolon-delimited for multi-backend.
         Override: dotnet build -p:ILGPUBackend=Metal
         Multi:    dotnet build -p:ILGPUBackend="CPU;Metal" -->
    <!-- Multi-backend (e.g. CPU;Metal) requires codegen fix for unique class names.
         Default to CPU for now; override with: dotnet build -p:ILGPUBackend=Metal -->
    <ILGPUBackend Condition="'$(ILGPUBackend)' == ''">CPU</ILGPUBackend>

    <!-- ILGPUC compiler tool invocation -->
    <ILGPUCompilerTool>dotnet "$(ILGPUBinDir)/ILGPUC.dll"</ILGPUCompilerTool>
  </PropertyGroup>

</Project>
