<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore from the local feed (../feed/, populated by pack-local.sh)
  AND nuget.org. The local feed serves your locally-built ILGPU +
  ILGPUC nupkgs; nuget.org serves whatever transitive deps they
  pull in (System.* etc).

  packageSources <clear /> wipes any inherited config so this sample
  doesn't pick up a default that would resolve ILGPUC from nuget.org
  instead of the local feed.

  The relative path "../feed" resolves against this NuGet.config's
  directory — i.e. ../../Samples/LocalNuGetConsumer/feed/ from the
  repo root.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-ilgpu-feed" value="../feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
